digraph G {
  rankdir=BT; nodesep=0.35; ranksep=0.6; labelloc=t; fontsize=20;
  label="Polymorphism 1: move effects and passive skills";
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9];
  MoveEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>MoveEffect</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ modifyAttack(AttackContext): void<BR ALIGN="LEFT"/>+ onUse(AttackContext): void<BR ALIGN="LEFT"/>+ afterHit(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PierceEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>PierceEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fraction: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PierceEffect(double)<BR ALIGN="LEFT"/>+ modifyAttack(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CritEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>CritEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- guaranteed: boolean<BR ALIGN="LEFT"/>- bonus: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CritEffect(boolean, double)<BR ALIGN="LEFT"/>+ modifyAttack(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  MultiHitEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>MultiHitEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- hits: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ MultiHitEffect(int)<BR ALIGN="LEFT"/>+ modifyAttack(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SureHitEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>SureHitEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SureHitEffect()<BR ALIGN="LEFT"/>+ modifyAttack(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DotEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>DotEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- type: DotType<BR ALIGN="LEFT"/>- percentOfMaxHp: double<BR ALIGN="LEFT"/>- turns: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ DotEffect(DotType, double, int)<BR ALIGN="LEFT"/>+ afterHit(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  StatDebuffEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>StatDebuffEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- stat: Stat<BR ALIGN="LEFT"/>- percent: double<BR ALIGN="LEFT"/>- turns: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ StatDebuffEffect(Stat, double, int)<BR ALIGN="LEFT"/>+ afterHit(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SelfBuffEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>SelfBuffEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- stat: Stat<BR ALIGN="LEFT"/>- flat: int<BR ALIGN="LEFT"/>- percent: double<BR ALIGN="LEFT"/>- turns: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SelfBuffEffect(Stat, int, double, int)<BR ALIGN="LEFT"/>+ onUse(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HealSelfEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>HealSelfEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- percent: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ HealSelfEffect(double)<BR ALIGN="LEFT"/>+ onUse(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DodgeBuffEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>DodgeBuffEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- percent: double<BR ALIGN="LEFT"/>- turns: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ DodgeBuffEffect(double, int)<BR ALIGN="LEFT"/>+ onUse(AttackContext): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EffectFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>EffectFactory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ parseList(String): List&lt;MoveEffect&gt;</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PassiveSkill [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>PassiveSkill</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getName(): String<BR ALIGN="LEFT"/>+ getDescription(): String<BR ALIGN="LEFT"/>+ onSwitchIn(Combatant, BattleLog): void<BR ALIGN="LEFT"/>+ onTurnStart(Combatant, BattleLog): void<BR ALIGN="LEFT"/>+ dodgeBonus(Combatant): double<BR ALIGN="LEFT"/>+ flatStatBonus(Combatant, Combatant, Stat): double<BR ALIGN="LEFT"/>+ statMultiplierOnOpponent(Stat): double<BR ALIGN="LEFT"/>+ outgoingDamageMultiplier(MoveKind): double<BR ALIGN="LEFT"/>+ incomingDamageMultiplier(MoveKind, boolean): double<BR ALIGN="LEFT"/>+ critChanceBonus(MoveKind): double<BR ALIGN="LEFT"/>+ attacksIgnoreDodge(): boolean<BR ALIGN="LEFT"/>+ immuneToDebuff(Stat): boolean<BR ALIGN="LEFT"/>+ extraEffects(MoveKind): List&lt;MoveEffect&gt;<BR ALIGN="LEFT"/>+ onMoveUsed(Combatant, MoveKind, BattleLog): void<BR ALIGN="LEFT"/>… +2 more<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AbstractPassive [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>AbstractPassive</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name: String<BR ALIGN="LEFT"/>- description: String<BR ALIGN="LEFT"/>- strength: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># AbstractPassive(String, String, double)<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ getDescription(): String<BR ALIGN="LEFT"/># getStrength(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Passives [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>Passives</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PassiveFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>PassiveFactory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ create(String, String, String, double): PassiveSkill</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PierceEffect -> MoveEffect [arrowhead=empty, style=dashed];
  CritEffect -> MoveEffect [arrowhead=empty, style=dashed];
  MultiHitEffect -> MoveEffect [arrowhead=empty, style=dashed];
  SureHitEffect -> MoveEffect [arrowhead=empty, style=dashed];
  DotEffect -> MoveEffect [arrowhead=empty, style=dashed];
  StatDebuffEffect -> MoveEffect [arrowhead=empty, style=dashed];
  SelfBuffEffect -> MoveEffect [arrowhead=empty, style=dashed];
  HealSelfEffect -> MoveEffect [arrowhead=empty, style=dashed];
  DodgeBuffEffect -> MoveEffect [arrowhead=empty, style=dashed];
  AbstractPassive -> PassiveSkill [arrowhead=empty, style=dashed];
}
