  Arena [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>Arena</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- HP_BAR_SECONDS: double</U><BR ALIGN="LEFT"/><U>- OPPONENT_SCALE: int</U><BR ALIGN="LEFT"/><U>- PLAYER_SCALE: int</U><BR ALIGN="LEFT"/><U>- MAX_SHOT_PIPS: int</U><BR ALIGN="LEFT"/>- engine: BattleEngine<BR ALIGN="LEFT"/>- field: BattlefieldType<BR ALIGN="LEFT"/>- shown: Combatant[]<BR ALIGN="LEFT"/>- hpShown: double[]<BR ALIGN="LEFT"/>- hpTarget: double[]<BR ALIGN="LEFT"/>- lunge: double[]<BR ALIGN="LEFT"/>- blink: double[]<BR ALIGN="LEFT"/>- dodge: double[]<BR ALIGN="LEFT"/>- enter: double[]<BR ALIGN="LEFT"/>- faint: double[]<BR ALIGN="LEFT"/>- gone: boolean[]<BR ALIGN="LEFT"/>- floaters: List&lt;Arena.Floater&gt;<BR ALIGN="LEFT"/>- clockText: String<BR ALIGN="LEFT"/>- clockLow: boolean<BR ALIGN="LEFT"/>- banner: String<BR ALIGN="LEFT"/>- bannerColor: Color<BR ALIGN="LEFT"/>- bannerAge: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Arena()<BR ALIGN="LEFT"/>+ reset(BattleEngine, BattlefieldType): void<BR ALIGN="LEFT"/>+ setField(BattlefieldType): void<BR ALIGN="LEFT"/>+ setClock(String, boolean): void<BR ALIGN="LEFT"/>+ setBanner(String, Color): void<BR ALIGN="LEFT"/>+ sendOut(Side, Combatant): void<BR ALIGN="LEFT"/>+ lunge(Side): void<BR ALIGN="LEFT"/>+ changeHp(Side, int): void<BR ALIGN="LEFT"/>+ dodge(Side): void<BR ALIGN="LEFT"/>+ faint(Side): void<BR ALIGN="LEFT"/>+ syncWithEngine(): void<BR ALIGN="LEFT"/>+ floatText(Side, String, Color, int): void<BR ALIGN="LEFT"/>+ advance(double): void<BR ALIGN="LEFT"/># paintComponent(Graphics): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  MessageBox [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>MessageBox</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- PADDING: int</U><BR ALIGN="LEFT"/><U>- HISTORY_LINES: int</U><BR ALIGN="LEFT"/><U>- MILLIS_PER_CHAR: double</U><BR ALIGN="LEFT"/>- history: List&lt;String&gt;<BR ALIGN="LEFT"/>- text: String<BR ALIGN="LEFT"/>- wrapped: List&lt;String&gt;<BR ALIGN="LEFT"/>- wrappedWidth: int<BR ALIGN="LEFT"/>- totalChars: int<BR ALIGN="LEFT"/>- revealed: double<BR ALIGN="LEFT"/>- isPrompt: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ MessageBox()<BR ALIGN="LEFT"/>+ push(String): void<BR ALIGN="LEFT"/>+ showPrompt(String): void<BR ALIGN="LEFT"/>+ clear(): void<BR ALIGN="LEFT"/>+ advance(double): void<BR ALIGN="LEFT"/>+ revealAll(): void<BR ALIGN="LEFT"/>+ isRevealed(): boolean<BR ALIGN="LEFT"/># paintComponent(Graphics): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
