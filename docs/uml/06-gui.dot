  BattlePanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>BattlePanel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- TICK_MILLIS: int</U><BR ALIGN="LEFT"/><U>- BOT_THINK_MILLIS: int</U><BR ALIGN="LEFT"/>- arena: Arena<BR ALIGN="LEFT"/>- messageBox: MessageBox<BR ALIGN="LEFT"/>- commandCards: CardLayout<BR ALIGN="LEFT"/>- commandArea: JPanel<BR ALIGN="LEFT"/>- itemsPanel: JPanel<BR ALIGN="LEFT"/>- replacePanel: JPanel<BR ALIGN="LEFT"/>- attackButton: RetroButton<BR ALIGN="LEFT"/>- signatureButton: RetroButton<BR ALIGN="LEFT"/>- ultimateButton: RetroButton<BR ALIGN="LEFT"/>- itemButton: RetroButton<BR ALIGN="LEFT"/>- restButton: RetroButton<BR ALIGN="LEFT"/>- forfeitButton: RetroButton<BR ALIGN="LEFT"/>- timer: Timer<BR ALIGN="LEFT"/>- queue: Deque&lt;BattleEvent&gt;<BR ALIGN="LEFT"/>- setup: MatchSetup<BR ALIGN="LEFT"/>- session: BattleSession<BR ALIGN="LEFT"/>- engine: BattleEngine<BR ALIGN="LEFT"/>- state: BattlePanel.UiState<BR ALIGN="LEFT"/>- eventActive: boolean<BR ALIGN="LEFT"/>- holdLeft: double<BR ALIGN="LEFT"/>- delayLeft: double<BR ALIGN="LEFT"/>- afterDelay: Runnable<BR ALIGN="LEFT"/>- fastForward: boolean<BR ALIGN="LEFT"/>- rewarded: boolean<BR ALIGN="LEFT"/>- lastTick: long<BR ALIGN="LEFT"/>- clockAccumulator: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ BattlePanel(GameWindow, GameContext)<BR ALIGN="LEFT"/>+ prepare(MatchSetup, BattleSession, BattlefieldType): void<BR ALIGN="LEFT"/>+ begin(): void<BR ALIGN="LEFT"/>+ stopTimers(): void<BR ALIGN="LEFT"/>+ onHide(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
