  GameContext [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>GameContext</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository: DragonRepository<BR ALIGN="LEFT"/>- profile: Profile<BR ALIGN="LEFT"/>- saveManager: SaveManager<BR ALIGN="LEFT"/>- gacha: GachaService<BR ALIGN="LEFT"/>- sound: SoundPlayer<BR ALIGN="LEFT"/>- random: Random<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GameContext(DragonRepository, Profile, SaveManager, GachaService, SoundPlayer, Random)<BR ALIGN="LEFT"/><U>+ createDefault(): GameContext</U><BR ALIGN="LEFT"/>+ getRepository(): DragonRepository<BR ALIGN="LEFT"/>+ getProfile(): Profile<BR ALIGN="LEFT"/>+ getGacha(): GachaService<BR ALIGN="LEFT"/>+ getSound(): SoundPlayer<BR ALIGN="LEFT"/>+ getRandom(): Random<BR ALIGN="LEFT"/>+ save(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
