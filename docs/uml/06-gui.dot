  MenuPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>MenuPanel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- soundButton: RetroButton<BR ALIGN="LEFT"/>- animation: Timer<BR ALIGN="LEFT"/>- tick: double<BR ALIGN="LEFT"/>- showcase: List&lt;DragonSpecies&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ MenuPanel(GameWindow, GameContext)<BR ALIGN="LEFT"/>+ onShow(): void<BR ALIGN="LEFT"/>+ removeNotify(): void<BR ALIGN="LEFT"/>+ onHide(): void<BR ALIGN="LEFT"/># paintComponent(Graphics): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EggPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>EggPanel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- SHAKE_MILLIS: int</U><BR ALIGN="LEFT"/><U>- FLASH_MILLIS: int</U><BR ALIGN="LEFT"/>- stage: EggPanel.EggStage<BR ALIGN="LEFT"/>- detail: DragonDetailPanel<BR ALIGN="LEFT"/>- openButton: RetroButton<BR ALIGN="LEFT"/>- timer: Timer<BR ALIGN="LEFT"/>- phase: EggPanel.Phase<BR ALIGN="LEFT"/>- phaseStart: long<BR ALIGN="LEFT"/>- lastCrack: int<BR ALIGN="LEFT"/>- hatched: OwnedDragon<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ EggPanel(GameWindow, GameContext)<BR ALIGN="LEFT"/>+ onShow(): void<BR ALIGN="LEFT"/>+ onHide(): void<BR ALIGN="LEFT"/>+ removeNotify(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
