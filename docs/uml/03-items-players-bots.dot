digraph G {
  rankdir=BT; nodesep=0.35; ranksep=0.6; labelloc=t; fontsize=20;
  label="Inheritance and polymorphism 2: items, players and bots";
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9];
  Item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>Item</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name: String<BR ALIGN="LEFT"/>- displayName: String<BR ALIGN="LEFT"/>- description: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># Item(String, String, String)<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ getDisplayName(): String<BR ALIGN="LEFT"/>+ getDescription(): String<BR ALIGN="LEFT"/>+ use(Combatant, BattleLog): boolean<BR ALIGN="LEFT"/>+ isUseful(Combatant): boolean<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HealItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>HealItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- percent: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ HealItem(String, String, double)<BR ALIGN="LEFT"/>+ isUseful(Combatant): boolean<BR ALIGN="LEFT"/>+ use(Combatant, BattleLog): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ReloadItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>ReloadItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- shots: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ReloadItem(String, String, int)<BR ALIGN="LEFT"/>+ isUseful(Combatant): boolean<BR ALIGN="LEFT"/>+ use(Combatant, BattleLog): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  BuffItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>BuffItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- stat: Stat<BR ALIGN="LEFT"/>- percent: double<BR ALIGN="LEFT"/>- turns: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ BuffItem(String, String, Stat, double, int)<BR ALIGN="LEFT"/>+ use(Combatant, BattleLog): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CleanseItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>CleanseItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CleanseItem(String, String)<BR ALIGN="LEFT"/>+ isUseful(Combatant): boolean<BR ALIGN="LEFT"/>+ use(Combatant, BattleLog): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ItemType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>ItemType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(): Item<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Player [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>Player</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name: String<BR ALIGN="LEFT"/>- team: List&lt;OwnedDragon&gt;<BR ALIGN="LEFT"/>- bag: List&lt;Item&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Player(String, List&lt;OwnedDragon&gt;, List&lt;Item&gt;)<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ getTeam(): List&lt;OwnedDragon&gt;<BR ALIGN="LEFT"/>+ getBag(): List&lt;Item&gt;<BR ALIGN="LEFT"/>+ isTimed(): boolean<BR ALIGN="LEFT"/>+ isBot(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  BotPlayer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>BotPlayer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- strategy: BotStrategy<BR ALIGN="LEFT"/>- difficulty: Difficulty<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ BotPlayer(String, List&lt;OwnedDragon&gt;, List&lt;Item&gt;, BotStrategy, Difficulty)<BR ALIGN="LEFT"/>+ getStrategy(): BotStrategy<BR ALIGN="LEFT"/>+ getDifficulty(): Difficulty<BR ALIGN="LEFT"/>+ isTimed(): boolean<BR ALIGN="LEFT"/>+ isBot(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Difficulty [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Difficulty</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- displayName: String<BR ALIGN="LEFT"/>- sWeightPercent: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDisplayName(): String<BR ALIGN="LEFT"/>+ getRarityPercent(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  BotStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>BotStrategy</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getName(): String<BR ALIGN="LEFT"/>+ chooseAction(BattleEngine, Side, Random): BattleAction<BR ALIGN="LEFT"/>+ chooseReplacement(BattleEngine, Side, Random): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RandomBotStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>RandomBotStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ RandomBotStrategy()<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ chooseAction(BattleEngine, Side, Random): BattleAction<BR ALIGN="LEFT"/>+ chooseReplacement(BattleEngine, Side, Random): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GreedyBotStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>GreedyBotStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GreedyBotStrategy()<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ chooseAction(BattleEngine, Side, Random): BattleAction<BR ALIGN="LEFT"/>+ chooseReplacement(BattleEngine, Side, Random): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SmartBotStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>SmartBotStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fallback: GreedyBotStrategy<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SmartBotStrategy()<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ chooseAction(BattleEngine, Side, Random): BattleAction<BR ALIGN="LEFT"/>+ chooseReplacement(BattleEngine, Side, Random): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  BotFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>BotFactory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ create(Difficulty, DragonRepository, Random): BotPlayer</U><BR ALIGN="LEFT"/><U>+ pickField(BotPlayer, Random): BattlefieldType</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  BotSupport [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff2b3"><B>BotSupport</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HealItem -> Item [arrowhead=empty];
  ReloadItem -> Item [arrowhead=empty];
  BuffItem -> Item [arrowhead=empty];
  CleanseItem -> Item [arrowhead=empty];
  Player -> Item [arrowhead=vee, arrowtail=diamond, dir=both, color="#555555"];
  BotPlayer -> Player [arrowhead=empty];
  BotPlayer -> BotStrategy [arrowhead=vee, arrowtail=diamond, dir=both, color="#555555"];
  BotPlayer -> Difficulty [arrowhead=vee, arrowtail=diamond, dir=both, color="#555555"];
  RandomBotStrategy -> BotStrategy [arrowhead=empty, style=dashed];
  GreedyBotStrategy -> BotStrategy [arrowhead=empty, style=dashed];
  SmartBotStrategy -> BotStrategy [arrowhead=empty, style=dashed];
  SmartBotStrategy -> GreedyBotStrategy [arrowhead=vee, arrowtail=diamond, dir=both, color="#555555"];
}
